---
import ParallaxBlob from "./ParallaxBlob.astro";

export interface Props {
  overline: string;
  title: string;
  subtitle?: string;
  overlineEn?: string;
  titleEn?: string;
  subtitleEn?: string;
  banner?: string;
}

const { overline, title, subtitle, overlineEn, titleEn, subtitleEn, banner } = Astro.props;
---

<section class="relative mesh-bg overflow-hidden pt-32 pb-14 sm:pt-40 sm:pb-20">
  {banner && (
    <>
      <img src={banner} alt="" class="absolute inset-0 h-full w-full object-cover" aria-hidden />
      <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/55" aria-hidden />
    </>
  )}
  <div class="tex-paper" aria-hidden />
  <ParallaxBlob className="-top-20 -right-16" color="#8a987a" size={360} blur={120} opacity={0.3} />
  <ParallaxBlob className="bottom-0 -left-16" color="#bec8a1" size={300} blur={120} opacity={0.4} />

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 md:px-12">
    <nav class={`flex items-center gap-1.5 text-xs sm:text-sm ${banner ? "text-brand-cream/75" : "text-brand-muted"}`}>
      <a href="/" class="hover:text-brand-cream transition-colors">
        <span data-lang="es">Inicio</span>
        <span data-lang="en">Home</span>
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={banner ? "text-brand-cream/60" : "text-brand-muted"}><polyline points="9 18 15 12 9 6"/></svg>
      <span class={`font-medium ${banner ? "text-brand-cream" : "text-brand-olive-2"}`}>
        <span data-lang="es">{title}</span>
        <span data-lang="en">{titleEn || title}</span>
      </span>
    </nav>

    <span class={`mt-6 block text-xs sm:text-sm uppercase tracking-[0.25em] font-medium animate-fade-in ${banner ? "text-brand-pale-sage" : "text-brand-sage"}`}>
      — <span data-lang="es">{overline}</span><span data-lang="en">{overlineEn || overline}</span>
    </span>
    <h1 class={`mt-3 font-display fluid-hero tracking-tight max-w-4xl animate-fade-in-up ${banner ? "text-brand-cream" : "text-brand-olive"}`}>
      <span data-lang="es">{title}</span>
      <span data-lang="en">{titleEn || title}</span>
    </h1>
    {subtitle && (
      <p class={`mt-5 fluid-body max-w-2xl leading-relaxed animate-fade-in-up-delay ${banner ? "text-brand-cream/85" : "text-brand-olive-2"}`}>
        <span data-lang="es">{subtitle}</span>
        <span data-lang="en">{subtitleEn || subtitle}</span>
      </p>
    )}
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.6s ease-out both; }
  .animate-fade-in-up { animation: fadeIn 0.7s ease-out 0.1s both; }
  .animate-fade-in-up-delay { animation: fadeIn 0.7s ease-out 0.2s both; }
</style>
