---
export interface Props {
  variant?: "cream" | "dough" | "swirl";
  bgColor?: string;
}

const { variant = "cream", bgColor = "var(--color-brand-cream)" } = Astro.props;

const shapes = {
  cream: {
    d: "M0,36 C240,96 480,0 720,48 C960,96 1200,0 1440,48 L1440,0 L0,0 Z",
    height: 72,
  },
  dough: {
    d: "M0,28 C180,72 360,0 540,36 C720,72 900,0 1080,36 C1260,72 1350,0 1440,28 L1440,0 L0,0 Z",
    height: 56,
  },
  swirl: {
    d: "M0,48 C200,100 400,12 600,56 C800,100 1000,0 1200,44 C1320,72 1380,12 1440,36 L1440,0 L0,0 Z",
    height: 80,
  },
};
const s = shapes[variant];
---

<div class="w-full overflow-hidden leading-none" style="height: {s.height}px; background: {bgColor};">
  <svg
    viewBox="0 0 1440 {s.height}"
    preserveAspectRatio="none"
    class="w-full h-full"
  >
    <path d={s.d} fill="var(--color-brand-cream-2)" />
    <path d={s.d} fill="var(--color-brand-pale-sage)" style="mix-blend-mode: multiply; opacity: 0.25; transform: translateY(-6px);" />
  </svg>
</div>
